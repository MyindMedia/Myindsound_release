# ── PostHog Analytics ──────────────────────────────────────────────
# Get from: https://us.posthog.com → Project Settings → Project API key
VITE_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# US Cloud (default). EU Cloud: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Clerk ──────────────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_...

# ── Convex ─────────────────────────────────────────────────────────
# Written to .env.local by `npx convex dev`; Netlify sets it during `npx convex deploy`)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Server secrets live in the Convex dashboard (Settings > Environment Variables), never here:
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRODUCT_ID_LIT, STRIPE_PRODUCT_ID_SOURCE
#   CLERK_SECRET_KEY, CLERK_JWT_ISSUER_DOMAIN, ADMIN_EMAILS
#   GHL_API_KEY, GHL_LOCATION_ID, SITE_URL, SOURCE_PRESALE_URL
# Audio lives in Convex file storage; `npm run upload:audio` uses your Convex CLI login.
